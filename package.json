  "scripts": {
    "start": "vite --mode localhost",
    "dev": "vite --mode localhost",
    "dev:local": "vite --mode localhost",
    "dev:dev": "vite --mode dev",
    "dev:uat": "vite --mode uat",
    "dev:prod": "vite --mode prod",
    "build": "REACT_APP_BUILD_DATE=$(date '+%Y-%m-%d %H:%M:%S') vite build --mode prod",
    "build:local": "REACT_APP_BUILD_DATE=$(date '+%Y-%m-%d %H:%M:%S') vite build --mode localhost",
    "build:dev": "REACT_APP_BUILD_DATE=$(date '+%Y-%m-%d %H:%M:%S') vite build --mode dev",
    "build:uat": "REACT_APP_BUILD_DATE=$(date '+%Y-%m-%d %H:%M:%S') vite build --mode uat",
    "build:prod": "REACT_APP_BUILD_DATE=$(date '+%Y-%m-%d %H:%M:%S') vite build --mode prod",
    "preview": "vite preview --mode prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\"",
    "changelog": "node scripts/generate-changelog.mjs",
    "generate:mock-preconfig": "node scripts/generate-preconfig-mock.mjs",
    "build:bump": "node scripts/release.mjs",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^2.1.4",
    "minimatch": "^3.1.2",
    "postcss": "^8.5.26",
    "follow-redirects": "^1.15.6",
    "yaml": "^2.3.4",
    "flatted": "^3.3.2",
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  },
  "resolutions": {
    "brace-expansion": "^2.1.4",
    "minimatch": "^3.1.2",
    "postcss": "^8.5.26",
    "follow-redirects": "^1.15.6",
    "yaml": "^2.3.4",
    "flatted": "^3.3.2",
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  }
